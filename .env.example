# Copy this file to .env and fill in real values. .env is gitignored.
#
# These are named PROD_-prefixed deliberately (not just CLOUDFLARE_WORKER_URL/
# CLOUDFLARE_API_TOKEN): an ambient CLOUDFLARE_API_TOKEN in the local shell
# environment collides with wrangler's OWN use of that exact name for
# Cloudflare account authentication, and broke `wrangler login`/`wrangler
# deploy` until these were renamed. This is purely a local-tooling naming
# choice — it has nothing to do with the Worker's own secret, which is a
# separate thing (see below) and keeps its original unprefixed name.

# Public URL of the deployed Cloudflare Worker (see wrangler.toml / src/worker.js)
PROD_CLOUDFLARE_WORKER_URL=https://ai-image-generator.<your-subdomain>.workers.dev/

# Shared bearer token sent as this project's own Authorization header. Must
# match the Worker's CLOUDFLARE_API_TOKEN secret (unprefixed — that name is
# set via `wrangler secret put CLOUDFLARE_API_TOKEN` and lives on the Worker
# in Cloudflare, not in this file; it is unrelated to the PROD_ prefix above).
PROD_CLOUDFLARE_API_TOKEN=

# Optional: only needed if you call the Cloudflare REST API directly
# (not required for talking to your own deployed Worker).
CLOUDFLARE_ACCOUNT_ID=
