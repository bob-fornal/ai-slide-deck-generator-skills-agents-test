# Copy this file to .env and fill in real values. .env is gitignored.

# Public URL of the deployed Cloudflare Worker (see wrangler.toml / src/worker.js)
CLOUDFLARE_WORKER_URL=https://ai-image-generator.<your-subdomain>.workers.dev/

# Shared bearer token. Must match the Worker's CLOUDFLARE_API_TOKEN secret,
# set via: wrangler secret put CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# Optional: only needed if you call the Cloudflare REST API directly
# (not required for talking to your own deployed Worker).
CLOUDFLARE_ACCOUNT_ID=
